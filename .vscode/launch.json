{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Vitest Current File",
      "autoAttachChildProcesses": true,
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": [
        "run",
        "--no-file-parallelism",
        "--no-coverage",
        "--test-timeout=0",
        "--hook-timeout=0",
        "${relativeFile}"
      ],
      "env": { "LOG_LEVEL": "debug" },
      "console": "integratedTerminal",
      "runtimeArgs": ["--nolazy", "--preserve-symlinks"],
      "skipFiles": ["<node_internals>/**/*.js"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Vitest All",
      "autoAttachChildProcesses": true,
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": [
        "run",
        "--no-file-parallelism",
        "--no-coverage",
        "--test-timeout=0",
        "--hook-timeout=0"
      ],
      "env": { "LOG_LEVEL": "debug" },
      "console": "integratedTerminal",
      "runtimeArgs": ["--nolazy", "--preserve-symlinks"],
      "skipFiles": ["<node_internals>/**/*.js"]
    }
  ]
}
