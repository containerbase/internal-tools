{
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "files.associations": {
    "Dockerfile.*": "dockerfile",
    ".releaserc": "json"
  },
  "omnisharp.autoStart": false,
  "search.exclude": {
    "**/.yarn": true,
    "**/.pnp.*": true
  }
}
