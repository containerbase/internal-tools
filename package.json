{
  "name": "internal-tools",
  "version": "5.3.12",
  "private": true,
  "license": "AGPL-3.0",
  "author": "Rhys Arkins <rhys@arkins.net>",
  "contributors": [
    "Michael Kriese <michael.kriese@visualon.de>"
  ],
  "repository": "https://github.com/containerbase/internal-tools.git",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "run-s compile",
    "clean": "rimraf dist/",
    "compile": "node tools/compile.js",
    "lint": "run-s oxfmt oxlint",
    "lint-fix": "run-s oxfmt-fix oxlint-fix",
    "oxfmt": "oxfmt --check",
    "oxfmt-fix": "oxfmt",
    "oxlint": "oxlint",
    "oxlint-fix": "oxlint --fix",
    "prepare": "husky",
    "release": "run-s clean compile semantic-release",
    "semantic-release": "semantic-release",
    "start": "run-s compile && node dist",
    "test:node": "NODE_ENV=debug INPUT_COMMAND=docker-builder INPUT_DRY_RUN=true INPUT_CONFIG=e2e/node.json INPUT_IMAGE_PREFIX=containerbase/ INPUT_IMAGE=node run-s start",
    "test:testing": "NODE_ENV=debug INPUT_COMMAND=docker-builder INPUT_DRY_RUN=true INPUT_CONFIG=e2e/testing.json INPUT_IMAGE_PREFIXES=ghcr.io/containerbase/ INPUT_PLATFORMS=linux/amd64,linux/arm64 run-s start",
    "test:vitest": "vitest run --coverage"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/github": "9.1.1",
    "@actions/io": "3.0.2",
    "@sindresorhus/is": "8.1.0",
    "auth-header": "1.0.0",
    "escape-string-regexp": "5.0.0",
    "find-up": "8.0.0",
    "got": "15.1.0",
    "renovate": "44.181.9",
    "semver": "7.8.5",
    "strip-ansi": "7.2.0",
    "tslib": "2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@containerbase/istanbul-reports-html": "2.0.23",
    "@containerbase/oxlint-plugin": "1.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@tsconfig/node24": "24.0.5",
    "@tsconfig/strictest": "2.0.8",
    "@types/auth-header": "1.0.6",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "@vitest/coverage-v8": "4.1.12",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "husky": "9.1.7",
    "jest-extended": "7.0.0",
    "lint-staged": "17.6.0",
    "luxon": "3.7.2",
    "nock": "14.0.17",
    "npm-run-all2": "9.0.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rimraf": "6.1.3",
    "rolldown": "1.2.15",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
