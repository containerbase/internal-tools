{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ConfigFile Schema",
  "description": "Configuration file schema for build operations",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "The schema to verify this document against."
    },
    "allowedVersions": {
      "type": "string"
    },
    "datasource": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "depName": {
      "type": "string"
    },
    "lookupName": {
      "type": "string"
    },
    "versioning": {
      "type": "string"
    },
    "startVersion": {
      "type": "string"
    },
    "cache": {
      "type": "string"
    },
    "buildArg": {
      "type": "string"
    },
    "ignoredVersions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forceUnstable": {
      "type": "boolean"
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "latestVersion": {
      "type": "string"
    },
    "maxVersions": {
      "type": "number"
    },
    "extractVersion": {
      "type": "string"
    },
    "skipLatestTag": {
      "type": "boolean"
    },
    "registryUrls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reverse": {
      "type": "boolean"
    },
    "test": {
      "type": "string",
      "description": "binary-builder: script path relative to the workspace, run after each build and before the upload with the archive path and the version as arguments."
    },
    "eol": {
      "type": "object",
      "description": "trigger-file: the endoflife.date product and the stream of the release blocks in the rebuild trigger file.",
      "properties": {
        "product": {
          "type": "string",
          "description": "The endoflife.date product."
        },
        "stream": {
          "enum": ["major", "minor"],
          "description": "Whether a release stream is the major or the major.minor version."
        },
        "file": {
          "type": "string",
          "description": "The trigger file, defaults to renovate.Dockerfile."
        }
      },
      "required": ["product", "stream"],
      "additionalProperties": false
    }
  },
  "required": ["startVersion"],
  "additionalProperties": false
}
